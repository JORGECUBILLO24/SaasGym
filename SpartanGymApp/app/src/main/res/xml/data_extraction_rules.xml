<?xml version="1.0" encoding="utf-8"?>
<!--
   Respaldo en la nube y transferencia entre equipos (Android 12+). Igual que backup_rules.xml:
   las credenciales del acceso con huella nunca salen del teléfono.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="acceso_biometrico.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="acceso_biometrico.xml" />
    </device-transfer>
</data-extraction-rules>
