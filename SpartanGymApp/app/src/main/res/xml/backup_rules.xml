<?xml version="1.0" encoding="utf-8"?>
<!--
   Respaldo automático (Android 11 o anterior). Las credenciales del acceso con huella
   (acceso_biometrico.xml) no se respaldan: aunque van cifradas, incluyen el correo y no
   sirven en otro teléfono (la llave queda en el Keystore del equipo original).
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="acceso_biometrico.xml" />
</full-backup-content>
